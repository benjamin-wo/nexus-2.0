# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM Provider: gemini | deepseek | openrouter
LLM_PROVIDER=gemini

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Selected models for each provider (optional, defaults will be used)
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3-8b

# DeepSeek cost tracking: USD per 1M tokens (optional, defaults track deepseek-chat pricing)
DEEPSEEK_INPUT_PRICE_PER_M=0.27
DEEPSEEK_OUTPUT_PRICE_PER_M=1.10

# Storage connection string (optional: if omitted, SQLite is used locally)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=

# LTA DataMall API for Singapore Transit
LTA_ACCOUNT_KEY=your_lta_account_key_here
